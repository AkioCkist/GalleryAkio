<?xml version="1.0" encoding="UTF-8"?>
<!-- Checks only what comes from JitPack, which unlike Google's Maven and Maven Central lets a
     published version change. Everything else is trusted as before. -->
<verification-metadata xmlns="https://schema.gradle.org/dependency-verification" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://schema.gradle.org/dependency-verification https://schema.gradle.org/dependency-verification/dependency-verification-1.3.xsd">
   <configuration>
      <verify-metadata>false</verify-metadata>
      <verify-signatures>false</verify-signatures>
      <trusted-artifacts>
         <trust group="^(?!com\.github\.T8RIN\.ImageToolboxLibs$).*$" regex="true"/>
      </trusted-artifacts>
   </configuration>
   <components>
      <component group="com.github.T8RIN.ImageToolboxLibs" name="gpuimage" version="8.1.2">
         <artifact name="gpuimage-8.1.2.aar">
            <sha256 value="2c3641a1f8797929c2cf15b1c08359d58876612343b1a67a7d718b082accb6e7"/>
         </artifact>
      </component>
   </components>
</verification-metadata>
